<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Cosmic Aventure</title>
    <link rel="stylesheet" href="css/index.css">
</head>
<body>
    <div id="gm-controls"></div>
    <div id="dice-panel"></div>
    <!-- Écran Menu -->
    <div id="menu-screen" class="screen">
        <div class="menu-container">
            <img src="img/logo.png" alt="Cosmic Aventure" class="logo">
            <h1>Cosmic Aventure</h1>
            <div class="menu-buttons">
                <button onclick="App.showScreen('character')" class="btn-primary">🎮 Nouvelle Partie</button>
                <button onclick="App.importSavePrompt()" class="btn-secondary">📥 Charger Sauvegarde</button>
                <button onclick="App.exportSave()" class="btn-secondary">💾 Exporter</button>
                <button onclick="App.showScreen('settings')" class="btn-secondary">⚙️ Options</button>
            </div>
        </div>
    </div>

    <!-- Écran Création Personnage -->
    <div id="character-screen" class="screen" style="display:none;">
        <div class="character-creation">
            <h2>Création de Personnage</h2>
            <input type="text" id="char-name" placeholder="Nom du personnage" maxlength="20">
            <select id="char-race">
                <option value="terrien">Terrien</option>
                <option value="martien">Martien</option>
                <option value="raelien">Raelien</option>
                <option value="ptitgris">Ptitgris</option>
            </select>
            <select id="char-class">
                <option value="ninja">Ninja Spatial</option>
                <option value="sorcier">Sorcier Cosmique</option>
                <option value="mercenaire">Mercenaire Blindé</option>
                <option value="necromancien">Nécromancien</option>
            </select>
            <button onclick="App.createCharacter(document.getElementById('char-name').value, document.getElementById('char-race').value, document.getElementById('char-class').value)" class="btn-primary">Créer</button>
            <button onclick="App.showScreen('menu')" class="btn-danger">Retour</button>
        </div>
    </div>

    <!-- Écran Jeu Principal -->
    <div id="game-screen" class="screen" style="display:none;">
        <div class="game-layout">
            <div class="character-panel">
                <h3 id="sheet-name">Nom</h3>
                <p id="sheet-class">Classe</p>
                <div class="stats-bar">
                    <span>❤️ <span id="sheet-hp">0/0</span></span>
                    <span>💙 <span id="sheet-mp">0/0</span></span>
                    <span>⭐ Niv.<span id="sheet-level">1</span></span>
                    <span>💰 <span id="sheet-credits">0</span></span>
                </div>
                <div class="xp-bar">
                    <span>XP: <span id="sheet-xp">0/50</span></span>
                </div>
            </div>
            <div class="story-panel">
                <div id="story-log" class="story-log"></div>
                <div class="action-buttons">
                    <button onclick="App.generateNextEncounter()" class="btn-primary">🚀 Explorer</button>
                    <button onclick="App.showScreen('combat')" class="btn-secondary" style="display:none;">Combat Test</button>
                </div>
            </div>
            <nav id="game-nav" class="game-nav"></nav>
        </div>
    </div>

    <!-- Écran Combat -->
    <div id="combat-screen" class="screen" style="display:none;"></div>

    <!-- Écran Inventaire -->
    <div id="inventory-screen" class="screen" style="display:none;">
        <div class="screen-header">
            <h2>🎒 Inventaire</h2>
            <button onclick="App.showScreen('game')" class="btn-danger">✕</button>
        </div>
        <div id="inventory-content" class="inventory-content"></div>
    </div>

    <!-- Écran Compétences -->
    <div id="skills-screen" class="screen" style="display:none;">
        <div class="screen-header">
            <h2>🌟 Arbre de Compétences</h2>
            <button onclick="App.showScreen('game')" class="btn-danger">✕</button>
        </div>
        <div id="skills-content" class="skills-content"></div>
        <div class="skill-points">Points disponibles: <span id="skill-points">0</span></div>
    </div>

    <!-- Écran Vaisseau -->
    <div id="ship-screen" class="screen" style="display:none;">
        <div class="screen-header">
            <h2>🚀 Vaisseau & Cargo</h2>
            <button onclick="App.showScreen('game')" class="btn-danger">✕</button>
        </div>
        <div id="ship-content" class="ship-content"></div>
    </div>

    <!-- Écran Quêtes -->
    <div id="quest-screen" class="screen" style="display:none;">
        <div class="screen-header">
            <h2>📜 Journal de Quêtes</h2>
            <button onclick="App.showScreen('game')" class="btn-danger">✕</button>
        </div>
        <div id="quest-content" class="quest-content"></div>
    </div>

    <!-- Écran Carte -->
    <div id="map-screen" class="screen" style="display:none;">

        <!-- Écran Craft -->
        <div id="craft-screen" class="screen" style="display:none;">
            <div class="screen-header">
                <h2>⚒️ Atelier de Fabrication</h2>
                <button onclick="App.showScreen('game')" class="btn-danger">X</button>
            </div>
            <div id="craft-content" class="craft-content"></div>
        </div>

        <!-- Écran Grimoire -->
        <div id="grimoire-screen" class="screen" style="display:none;">
            <div class="screen-header">
                <h2>📖 Grimoire</h2>
                <button onclick="App.showScreen('game')" class="btn-danger">X</button>
            </div>
            <div id="grimoire-content" class="grimoire-content"></div>
        </div>
        <div class="screen-header">
            <h2>🗺️ Carte Stellaire</h2>
            <button onclick="App.showScreen('game')" class="btn-danger">✕</button>
        </div>
        <div id="map-content" class="map-content">
            <div class="star-map" id="star-map"></div>
        </div>
    </div>

    <!-- Écran Options -->
    <div id="settings-screen" class="screen" style="display:none;">
        <div class="screen-header">
            <h2>⚙️ Options</h2>
            <button onclick="App.showScreen('menu')" class="btn-danger">✕</button>
        </div>
        <div class="settings-content">
            <button onclick="App.exportSave()" class="btn-primary">💾 Exporter Sauvegarde</button>
            <button onclick="App.importSavePrompt()" class="btn-primary">📥 Importer Sauvegarde</button>
            <button onclick="if(confirm('Effacer toutes les données ?')){localStorage.clear();location.reload();}" class="btn-danger">🗑️ Réinitialiser</button>
        </div>
    </div>

    <!-- Game Master Chat -->
    <div id="gm-panel" class="gm-panel" style="display:none;">
        <div id="gm-messages" class="gm-messages"></div>
        <div id="gm-typing" class="gm-typing" style="display:none;">
            <span class="gm-typing-dot"></span>
            <span class="gm-typing-dot"></span>
            <span class="gm-typing-dot"></span>
            <span>Le MJ réfléchit...</span>
        </div>
        <div id="gm-choices" class="gm-choices"></div>
        <div class="gm-input-area">
            <input type="text" id="gm-input" class="gm-input" placeholder="Parler au MJ..." maxlength="200">
            <button id="gm-send-btn" class="gm-send-btn">➤</button>
        </div>
    </div>

    <!-- Scripts -->
    <script src="js/ai/images.js"></script>
    <script src="js/game/rules.js"></script>
    <script src="js/game/races.js"></script>
    <script src="js/game/grimoire.js"></script>
    <script src="js/game/items.js"></script>
    <script src="js/game/craft.js"></script>
    <script src="js/game/quests.js"></script>
    <script src="js/game/gameMaster.js"></script>
    <script src="js/system/storage.js"></script>
    <script src="js/system/apiManager.js"></script>
    <script src="js/game/combat.js"></script>
    <script src="js/ui/inventory.js"></script>
    <script src="js/ui/skills.js"></script>
    <script src="js/ui/ship.js"></script>
    <script src="js/ui/quest.js"></script>
    <script src="js/ui/map.js"></script>
    <script src="js/ui/manager.js"></script>
    <script src="js/ui/gameMasterChat.js"></script>
    <script src="js/ui/dice.js"></script>
    <script src="js/app.js"></script>
</body>
</html>
